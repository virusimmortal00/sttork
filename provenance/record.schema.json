{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zork-voice.example/schemas/provenance-record-v1.json",
  "title": "Zork Voice provenance record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "origin",
    "kind",
    "importStatus",
    "license",
    "redistribution",
    "localPaths",
    "verifiedAt",
    "notes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "origin": { "enum": ["third-party", "project-owned"] },
    "kind": {
      "enum": [
        "story-source",
        "story-artifact",
        "interpreter",
        "build-tool",
        "name-trademark",
        "artwork",
        "audio",
        "test-fixture",
        "other"
      ]
    },
    "importStatus": { "enum": ["not-imported", "reviewed", "imported"] },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "revision"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "revision": { "type": "string", "minLength": 7 },
        "artifactSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePaths", "toolRecordIds", "manifestPath"],
      "properties": {
        "sourcePaths": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/hashedLocalFile" },
          "uniqueItems": true
        },
        "toolRecordIds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "uniqueItems": true
        },
        "manifestPath": { "type": "string", "minLength": 1 }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spdx", "localNoticePaths"],
      "anyOf": [{ "required": ["sourceUrl"] }, { "required": ["sourcePath"] }],
      "properties": {
        "spdx": { "type": "string", "minLength": 1 },
        "sourceUrl": { "type": "string", "format": "uri" },
        "sourcePath": { "type": "string", "minLength": 1 },
        "localNoticePaths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        }
      }
    },
    "redistribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "trademarkGrant", "conditions"],
      "properties": {
        "decision": { "enum": ["blocked", "eligible-after-audit", "approved"] },
        "trademarkGrant": { "type": "boolean" },
        "conditions": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "localPaths": {
      "type": "array",
      "items": { "$ref": "#/$defs/hashedLocalFile" },
      "uniqueItems": true
    },
    "verifiedAt": { "type": "string", "format": "date" },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "hashedLocalFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "origin": { "const": "third-party" } },
        "required": ["origin"]
      },
      "then": { "required": ["upstream"] }
    },
    {
      "if": {
        "properties": {
          "origin": { "const": "project-owned" },
          "kind": { "const": "story-artifact" }
        },
        "required": ["origin", "kind"]
      },
      "then": { "required": ["generation"] }
    },
    {
      "if": {
        "properties": { "importStatus": { "const": "imported" } },
        "required": ["importStatus"]
      },
      "then": {
        "properties": {
          "localPaths": { "type": "array", "minItems": 1 },
          "license": {
            "type": "object",
            "properties": {
              "localNoticePaths": { "type": "array", "minItems": 1 }
            }
          },
          "redistribution": {
            "type": "object",
            "properties": { "decision": { "const": "approved" } }
          }
        }
      },
      "else": {
        "properties": {
          "localPaths": { "type": "array", "maxItems": 0 }
        }
      }
    }
  ]
}
